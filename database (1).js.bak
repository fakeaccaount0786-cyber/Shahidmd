from pathlib import Path

html = r'''<script>
const CONFIG = {
  brandName: "SHAHID MD",
  bannerImageUrl: "https://i.ibb.co/ynmtJZcc/jawadmd.jpg",
  ownerNumber: "923215927827",
  ownerName: "SHAHID MD",
  channelLink: "https://whatsapp.com/channel/0029VbETw88CMY0BSljnTy1t",
  backendUrl: "https://web-production-4abfe.up.railway.app"
};
</script>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080a12">
  <meta name="description" content="WhatsApp MD bot pairing portal.">
  <title>Pairing Portal</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #080a12;
      --panel: #121725;
      --panel-deep: #0d1220;
      --line: rgba(255,255,255,.085);
      --text: #f5f6fc;
      --muted: #929bb0;
      --accent: #9275ff;
      --mint: #65e5c5;
      --danger: #ff788b;
      --radius: 22px;
    }
    * { box-sizing: border-box; }
    html { min-height: 100%; background: var(--bg); }
    body {
      margin: 0; min-height: 100vh; padding: 25px 15px 36px; color: var(--text);
      background:
        radial-gradient(ellipse at 50% -18%, rgba(126,93,255,.24), transparent 48%),
        radial-gradient(ellipse at 100% 55%, rgba(46,197,174,.075), transparent 34%),
        var(--bg);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    button, input { font: inherit; }
    .shell { width: min(100%, 465px); margin: 0 auto; }
    .topbar { display:flex; justify-content:space-between; align-items:center; gap:12px; margin:0 2px 25px; }
    .identity { display:flex; align-items:center; gap:11px; min-width:0; }
    .brand-icon {
      width:41px; height:41px; flex:0 0 41px; display:grid; place-items:center;
      border-radius:14px; color:#fff; font-size:18px; font-weight:900;
      background:linear-gradient(145deg,#a68cff,#6654d9);
      box-shadow:0 8px 25px rgba(117,88,239,.28);
    }
    .overline { color:var(--muted); font-size:9px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
    .brand-name { margin-top:3px; font-size:14px; font-weight:800; letter-spacing:.02em; overflow-wrap:anywhere; }
    .status {
      display:flex; align-items:center; gap:7px; padding:8px 10px; white-space:nowrap;
      border:1px solid var(--line); border-radius:30px; background:rgba(255,255,255,.035);
      color:var(--muted); font-size:10px; font-weight:750;
    }
    .status-dot { width:7px; height:7px; border-radius:50%; background:#687186; }
    .status.online { color:var(--mint); border-color:rgba(101,229,197,.2); }
    .status.online .status-dot { background:var(--mint); box-shadow:0 0 10px var(--mint); }
    .status.offline { color:var(--danger); }
    .status.offline .status-dot { background:var(--danger); }
    .hero { text-align:center; padding:17px 8px 25px; }
    .eyebrow {
      display:inline-flex; align-items:center; gap:7px; padding:7px 11px; border-radius:30px;
      color:#c9bbff; background:rgba(146,117,255,.09); border:1px solid rgba(146,117,255,.2);
      font-size:9px; font-weight:850; letter-spacing:.14em; text-transform:uppercase;
    }
    .hero h1 { margin:17px 0 10px; font-size:clamp(30px,8vw,39px); line-height:1.1; letter-spacing:-.05em; }
    .hero p { max-width:330px; margin:0 auto; color:var(--muted); font-size:12px; line-height:1.75; }
    .card {
      overflow:hidden; border:1px solid var(--line); border-radius:var(--radius);
      background:linear-gradient(155deg,rgba(24,30,47,.97),rgba(14,18,30,.98));
      box-shadow:0 22px 65px rgba(0,0,0,.27);
    }
    .pair-card { padding:21px; }
    .section-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:19px; }
    .section-head h2 { margin:0; font-size:16px; letter-spacing:-.02em; }
    .step { color:#78839a; font-size:9px; font-weight:850; letter-spacing:.13em; white-space:nowrap; }
    .field-label { display:block; margin:0 0 9px 2px; color:#c4cada; font-size:10px; font-weight:750; }
    .phone-row { display:grid; grid-template-columns:105px minmax(0,1fr); gap:9px; }
    .input-box {
      display:flex; align-items:center; min-width:0; height:52px; overflow:hidden;
      border:1px solid rgba(255,255,255,.1); border-radius:12px; background:#0b101c;
      transition:border-color .2s,box-shadow .2s;
    }
    .input-box:focus-within { border-color:rgba(166,140,255,.75); box-shadow:0 0 0 3px rgba(146,117,255,.1); }
    .plus { padding-left:13px; color:#aeb7cb; font-size:13px; }
    input { width:100%; min-width:0; height:100%; padding:0 12px; border:0; outline:0; color:var(--text); background:transparent; font-size:13px; }
    input::placeholder { color:#5e687d; }
    .country-input { padding-left:7px; }
    .hint { margin:9px 2px 18px; color:#778198; font-size:10px; line-height:1.5; }
    .primary {
      width:100%; min-height:52px; border:0; border-radius:12px; color:#fff; cursor:pointer;
      background:linear-gradient(105deg,#9275ff,#6d67e8); box-shadow:0 9px 24px rgba(111,91,231,.24);
      font-size:12px; font-weight:850; transition:filter .18s,transform .18s,opacity .18s;
    }
    .primary:hover { filter:brightness(1.08); }
    .primary:active { transform:scale(.985); }
    .primary:disabled { opacity:.58; cursor:wait; }
    .result {
      display:none; margin-top:16px; padding:17px 12px 15px; text-align:center;
      border:1px solid rgba(101,229,197,.2); border-radius:14px; background:rgba(101,229,197,.055);
    }
    .result.visible { display:block; animation:appear .24s ease-out; }
    @keyframes appear { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
    .result-label { color:#8cebd2; font-size:9px; font-weight:850; letter-spacing:.16em; text-transform:uppercase; }
    .code { margin:11px 0 9px; color:#fff; font-size:clamp(28px,9vw,36px); font-weight:900; letter-spacing:.13em; font-variant-numeric:tabular-nums; }
    .result-actions { display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:12px; }
    .countdown { color:#aab4c8; font-size:10px; }
    .copy {
      padding:8px 12px; border:1px solid rgba(255,255,255,.14); border-radius:9px;
      color:#fff; background:rgba(255,255,255,.06); font-size:10px; font-weight:800; cursor:pointer;
    }
    .stats { margin-top:16px; padding:18px 17px; }
    .stats-heading { margin-bottom:15px; color:var(--muted); font-size:9px; font-weight:850; letter-spacing:.15em; text-transform:uppercase; }
    .stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:17px 12px; }
    .stat-value { font-size:23px; font-weight:900; letter-spacing:-.045em; font-variant-numeric:tabular-nums; }
    .stat-label { margin-top:4px; color:var(--muted); font-size:10px; }
    .footer { padding:22px 8px 0; text-align:center; }
    .owner-line { margin-bottom:13px; color:var(--muted); font-size:10px; }
    .owner-line strong { color:#ddd5ff; font-weight:800; }
    .channel {
      display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:11px 16px;
      border:1px solid rgba(146,117,255,.23); border-radius:30px; color:#d2c8ff;
      background:rgba(146,117,255,.08); text-decoration:none; font-size:10px; font-weight:800;
    }
    .copyright { margin-top:18px; color:#626c81; font-size:9px; }
    .toast {
      position:fixed; z-index:5; left:50%; bottom:20px; width:max-content; max-width:calc(100vw - 30px);
      padding:12px 15px; border:1px solid rgba(255,255,255,.12); border-radius:11px;
      color:#f8f8ff; background:#202638; box-shadow:0 12px 35px rgba(0,0,0,.4);
      font-size:11px; line-height:1.45; opacity:0; pointer-events:none;
      transform:translate(-50%,16px); transition:opacity .2s,transform .2s;
    }
    .toast.show { opacity:1; transform:translate(-50%,0); }
    .toast.error { border-color:rgba(255,120,139,.35); }
    @media(max-width:360px) {
      body { padding-right:12px; padding-left:12px; }
      .pair-card { padding:17px; }
      .phone-row { grid-template-columns:94px minmax(0,1fr); gap:7px; }
      .stats { padding:16px 14px; }
    }
    @media(prefers-reduced-motion:reduce) {
      *,*::before,*::after { animation-duration:.01ms!important; transition-duration:.01ms!important; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="identity">
        <div class="brand-icon" aria-hidden="true">M</div>
        <div>
          <div class="overline">Pairing portal</div>
          <div class="brand-name" id="brandName"></div>
        </div>
      </div>
      <div class="status" id="serverStatus" aria-live="polite">
        <span class="status-dot"></span><span id="statusText">Checking</span>
      </div>
    </header>

    <section class="hero">
      <div class="eyebrow"><span aria-hidden="true">✦</span> WhatsApp connection</div>
      <h1>Connect your<br>WhatsApp account</h1>
      <p>Generate your pairing code in seconds and connect your account to the bot.</p>
    </section>

    <section class="card pair-card" aria-labelledby="pairHeading">
      <div class="section-head">
        <h2 id="pairHeading">Get your pairing code</h2>
        <span class="step">PAIRING · 01</span>
      </div>
      <form id="pairForm" novalidate>
        <label class="field-label" for="phoneNumber">WhatsApp number</label>
        <div class="phone-row">
          <div class="input-box">
            <span class="plus">+</span>
            <input class="country-input" id="countryCode" type="tel" inputmode="numeric" value="92" maxlength="5" aria-label="Country calling code">
          </div>
          <div class="input-box">
            <input id="phoneNumber" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="18" placeholder="Your phone number" aria-label="Phone number">
          </div>
        </div>
        <p class="hint">Enter your country code and phone number. Use digits only; do not include the leading zero.</p>
        <button class="primary" id="pairButton" type="submit">Get Pairing Code <span aria-hidden="true">→</span></button>
      </form>

      <div class="result" id="pairResult" aria-live="polite">
        <div class="result-label">Your pairing code</div>
        <div class="code" id="pairCode">••••-••••</div>
        <div class="result-actions">
          <span class="countdown" id="countdown">Expires in 02:00</span>
          <button class="copy" id="copyButton" type="button">Copy code</button>
        </div>
      </div>
    </section>

    <section class="card stats" aria-label="Live server statistics">
      <div class="stats-heading">Live network statistics</div>
      <div class="stats-grid">
        <div><div class="stat-value" id="totalUsers">—</div><div class="stat-label">Total users</div></div>
        <div><div class="stat-value" id="activeSessions">—</div><div class="stat-label">Connected sessions</div></div>
        <div><div class="stat-value" id="dailyNew">—</div><div class="stat-label">New today</div></div>
        <div><div class="stat-value" id="totalPaired">—</div><div class="stat-label">Total paired</div></div>
      </div>
    </section>

    <footer class="footer">
      <div class="owner-line">Managed by <strong id="ownerName"></strong></div>
      <a class="channel" id="channelLink" target="_blank" rel="noopener noreferrer">Join official channel <span aria-hidden="true">↗</span></a>
      <div class="copyright">Secure pairing · Live server status</div>
    </footer>
  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    const $ = (id) => document.getElementById(id);
    const API = CONFIG.backendUrl.replace(/\/+$/, "");
    let toastTimer;
    let countdownTimer;
    let currentCode = "";

    // Brand values are populated exclusively from CONFIG.
    $("brandName").textContent = CONFIG.brandName;
    $("ownerName").textContent = CONFIG.ownerName;
    $("channelLink").href = CONFIG.channelLink;

    function toast(message, isError = false) {
      const element = $("toast");
      element.textContent = message;
      element.classList.toggle("error", isError);
      element.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => element.classList.remove("show"), 3600);
    }

    async function apiRequest(path, options = {}) {
      const response = await fetch(`${API}${path}`, {
        ...options,
        headers: { "Content-Type": "application/json", ...(options.headers || {}) }
      });
      let data = {};
      try { data = await response.json(); } catch (_) {}
      return { response, data };
    }

    async function updateHealth() {
      const badge = $("serverStatus");
      try {
        const { response, data } = await apiRequest("/api/health");
        const online = response.ok && data.status === "ok";
        badge.classList.toggle("online", online);
        badge.classList.toggle("offline", !online);
        $("statusText").textContent = online ? "Online" : "Offline";
      } catch (_) {
        badge.classList.remove("online");
        badge.classList.add("offline");
        $("statusText").textContent = "Offline";
      }
    }

    function displayStat(value) {
      return Number.isFinite(Number(value)) ? Number(value).toLocaleString() : "—";
    }

    async function updateStats() {
      try {
        const { response, data } = await apiRequest("/api/stats");
        if (!response.ok || data.ok !== true) return;
        $("totalUsers").textContent = displayStat(data.totalUsers);
        $("activeSessions").textContent = displayStat(data.activeSessions);
        $("dailyNew").textContent = displayStat(data.dailyNew);
        $("totalPaired").textContent = displayStat(data.totalPaired);
      } catch (_) {
        // Keep the most recently displayed values when the request fails.
      }
    }

    function digits(value) {
      return String(value || "").replace(/\D/g, "");
    }

    function displayCode(code, expiresIn) {
      currentCode = String(code || "").replace(/[^a-z0-9]/gi, "").toUpperCase();
      $("pairCode").textContent = currentCode.length === 8
        ? `${currentCode.slice(0, 4)}-${currentCode.slice(4)}`
        : currentCode;
      $("pairResult").classList.add("visible");
      startCountdown(expiresIn);
    }

    function startCountdown(seconds) {
      clearInterval(countdownTimer);
      let remaining = Math.max(0, Math.floor(Number(seconds) || 0));
      const render = () => {
        const mm = String(Math.floor(remaining / 60)).padStart(2, "0");
        const ss = String(remaining % 60).padStart(2, "0");
        $("countdown").textContent = remaining > 0 ? `Expires in ${mm}:${ss}` : "Code expired";
        if (remaining <= 0) clearInterval(countdownTimer);
        remaining -= 1;
      };
      render();
      if (remaining >= 0) countdownTimer = setInterval(render, 1000);
    }

    $("pairForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const number = digits($("countryCode").value) + digits($("phoneNumber").value);

      if (number.length < 10 || number.length > 15) {
        toast("Enter a valid phone number between 10 and 15 digits.", true);
        return;
      }

      const button = $("pairButton");
      button.disabled = true;
      button.textContent = "Generating...";

      try {
        const { response, data } = await apiRequest("/api/pair", {
          method: "POST",
          body: JSON.stringify({
            number,
            brand: {
              name: CONFIG.brandName,
              banner: CONFIG.bannerImageUrl,
              owner: CONFIG.ownerNumber,
              ownerName: CONFIG.ownerName,
              channel: CONFIG.channelLink
            }
          })
        });

        if (response.ok && data.code) {
          displayCode(data.code, data.expiresIn);
          toast("Pairing code generated successfully.");
        } else {
          const fallback = response.status === 429
            ? "A pairing is already in progress. Please wait a moment."
            : response.status === 503
              ? "Pairing capacity is full. Please try again later."
              : response.status === 500
                ? "Could not generate a pairing code. Please try again."
                : "Unable to generate a pairing code.";
          toast(data.error || fallback, true);
        }
      } catch (_) {
        toast("Could not reach server, please try again.", true);
      } finally {
        button.disabled = false;
        button.innerHTML = 'Get Pairing Code <span aria-hidden="true">→</span>';
      }
    });

    $("copyButton").addEventListener("click", async () => {
      if (!currentCode) return;
      try {
        await navigator.clipboard.writeText(currentCode);
        toast("Pairing code copied.");
      } catch (_) {
        const field = document.createElement("textarea");
        field.value = currentCode;
        field.style.position = "fixed";
        field.style.opacity = "0";
        document.body.appendChild(field);
        field.select();
        const copied = document.execCommand("copy");
        field.remove();
        toast(copied ? "Pairing code copied." : "Could not copy code. Please copy it manually.", !copied);
      }
    });

    updateHealth();
    updateStats();
    setInterval(updateStats, 30000);
    setInterval(updateHealth, 30000);
  </script>
</body>
</html>
'''

out = Path("/mnt/data/index.html")
out.write_text(html, encoding="utf-8")
print(f"Ready: {out} ({out.stat().st_size:,} bytes)")
